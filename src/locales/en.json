    "faq": {
      "admin": [
        {
          "question": "How do I add a new user (doctor or patient)?",
          "answer": "Go to \"Users\" and use the add button, fill in the details and choose the role (admin, doctor, or patient)."
        },
        {
          "question": "How do I publish availability slots for a doctor?",
          "answer": "Go to \"Operations\" (Agenda) → \"Schedule Resource\" → \"Publish Availability\" mode, pick the doctor, branch, date, and time."
        },
        {
          "question": "What does the \"Revenue\" number on the dashboard mean?",
          "answer": "It's the sum of the amounts of every registered Billing Claim, not necessarily money already collected."
        },
        {
          "question": "How do I check the status of billing claims?",
          "answer": "Go to the \"Billing\" section, where you can view, authorize, and export existing claims."
        }
      ],
      "doctor": [
        {
          "question": "How do I see today's agenda?",
          "answer": "Go to \"Agenda\" to see your scheduled appointments for the selected date."
        },
        {
          "question": "How do I record a diagnosis or treatment?",
          "answer": "Open the patient's record from \"Patients\" and add the diagnosis or treatment to their medical history."
        },
        {
          "question": "Can I publish my own availability slots?",
          "answer": "Right now only the admin can do that from their panel — contact them if you need new time slots."
        },
        {
          "question": "How do I issue a prescription?",
          "answer": "From the patient's clinical record, in the treatment section, you can add a prescription with medicines and dosage."
        }
      ],
      "patient": [
        {
          "question": "How do I book a new consultation?",
          "answer": "Go to \"Appointments\" → \"Book New Consultation\", choose branch, specialty, doctor, date, and an available time."
        },
        {
          "question": "How do I see my medical history?",
          "answer": "Go to the \"History\" section to see your past diagnoses, treatments, and medical records."
        },
        {
          "question": "How do I cancel or reschedule an appointment?",
          "answer": "From \"Appointments\", select the active appointment and use the reschedule/cancel options."
        },
        {
          "question": "Where can I see my prescriptions?",
          "answer": "The \"Prescriptions\" section shows the medicines prescribed by your doctor."
        },
        {
          "question": "How do I pay for a pending appointment?",
          "answer": "From \"Appointments\", on the appointment with a pending payment, use the payment button to complete the charge."
        }
      ]
    }
  },
