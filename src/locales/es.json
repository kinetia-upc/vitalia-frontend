    "faq": {
      "admin": [
        {
          "question": "¿Cómo agrego un nuevo usuario (doctor o paciente)?",
          "answer": "Ve a \"Users\" y usa el botón para añadir uno nuevo, completa sus datos y elige el rol (admin, doctor o patient)."
        },
        {
          "question": "¿Cómo publico horarios de disponibilidad para un doctor?",
          "answer": "Ve a \"Operations\" (Agenda) → \"Schedule Resource\" → modo \"Publish Availability\", elige doctor, sucursal, fecha y hora."
        },
        {
          "question": "¿Qué significa el número de \"Ingresos\" en el dashboard?",
          "answer": "Es la suma de los montos de todos los reclamos de facturación (Billing Claims) registrados, no necesariamente dinero ya cobrado."
        },
        {
          "question": "¿Cómo veo el estado de los reclamos de facturación?",
          "answer": "Ve a la sección \"Billing\", ahí puedes ver, autorizar y exportar los reclamos existentes."
        }
      ],
      "doctor": [
        {
          "question": "¿Cómo veo mi agenda del día?",
          "answer": "Ve a \"Agenda\" para ver tus citas programadas en la fecha seleccionada."
        },
        {
          "question": "¿Cómo registro un diagnóstico o tratamiento?",
          "answer": "Abre la ficha del paciente desde \"Patients\" y agrega el diagnóstico o tratamiento a su historial médico."
        },
        {
          "question": "¿Puedo publicar mis propios horarios de disponibilidad?",
          "answer": "Por ahora esa función solo la puede hacer el administrador desde su panel; contáctalo si necesitas nuevos horarios."
        },
        {
          "question": "¿Cómo emito una receta médica?",
          "answer": "Desde la ficha clínica del paciente, en la sección de tratamiento, puedes añadir una prescripción con medicamentos y dosis."
        }
      ],
      "patient": [
        {
          "question": "¿Cómo reservo una nueva consulta?",
          "answer": "Ve a \"Appointments\" → \"Book New Consultation\", elige sucursal, especialidad, doctor, fecha y un horario disponible."
        },
        {
          "question": "¿Cómo veo mi historial médico?",
          "answer": "Ve a la sección \"History\" para ver tus diagnósticos, tratamientos y registros médicos anteriores."
        },
        {
          "question": "¿Cómo cancelo o reprogramo una cita?",
          "answer": "Desde \"Appointments\", selecciona la cita activa y usa las opciones de reprogramar o cancelar."
        },
        {
          "question": "¿Dónde veo mis recetas médicas?",
          "answer": "En la sección \"Prescriptions\" encuentras los medicamentos recetados por tu doctor."
        },
        {
          "question": "¿Cómo pago una cita pendiente?",
          "answer": "Desde \"Appointments\", en la cita con pago pendiente, usa el botón de pago para completar el cobro."
        }
      ]
    }
  },
